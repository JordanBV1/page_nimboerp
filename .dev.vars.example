# Copia este archivo como .dev.vars (para desarrollo local) o
# configura las variables en el dashboard de Cloudflare (producción)

NOTIFY_EMAIL="nimboerp@gmail.com"

# ============================================
# EmailJS - https://dashboard.emailjs.com (gratis)
# 1. Crea cuenta y ve a "Email Services" -> "Add New Service" -> Gmail -> conecta tu correo
# 2. Ve a "Email Templates" -> "New Template":
#    - Asunto (Subject): {{subject}}
#    - HTML: pega las variables que quieras, ej:
#      Nombre: {{from_name}}<br>
#      Correo: {{from_email}}<br>
#      Empresa: {{business_name}}<br>
#      Sector: {{sector}}<br>
#      Teléfono: {{telefono}}<br>
#      Empleados: {{empleados}}
#    - Configura el template para enviar a {{to_email}}
# 3. Ve a "Account" -> "API Keys": copia Public Key y Private Key
EMAILJS_SERVICE_ID=""
EMAILJS_TEMPLATE_ID=""
EMAILJS_PUBLIC_KEY=""
EMAILJS_PRIVATE_KEY=""
