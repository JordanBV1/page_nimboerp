{
  "name": "page-nimboerp",
  "version": "1.0.0",
  "private": true,
  "description": "Landing page + backend de reservas de Nimbo ERP (Cloudflare Pages + D1)",
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev public",
